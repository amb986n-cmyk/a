using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using System.Text.Json;

class Producto
{
    public string Nombre { get; set; }
    public int Cantidad { get; set; }
    public decimal Precio { get; set; }
    public decimal ValorTotal => Cantidad * Precio;
}

class RepositorioProductos
{
    private readonly string ArchivoJSON;
    private List<Producto> _productos;
    private decimal _valorTotalCache = 0;
    private bool _cambiosPendientes = false;

    public IReadOnlyList<Producto> Productos => _productos;

    public RepositorioProductos()
    {
        if (OperatingSystem.IsWindows())
            ArchivoJSON = "inventario.json";
        else
            ArchivoJSON = ".inventario.json";

        _productos = Cargar();
        RecalcularValorTotal();

        if (OperatingSystem.IsWindows() && File.Exists(ArchivoJSON))
        {
            File.SetAttributes(ArchivoJSON, FileAttributes.Hidden);
        }
    }

    public void Añadir(Producto nuevo)
    {
        for (int i = 0; i < _productos.Count; i++)
        {
            var p = _productos[i];
            if (p.Nombre.Equals(nuevo.Nombre, StringComparison.OrdinalIgnoreCase))
            {
                _valorTotalCache -= p.ValorTotal;
                p.Cantidad += nuevo.Cantidad;
                _valorTotalCache += p.ValorTotal;
                _cambiosPendientes = true;
                return;
            }
        }

        _productos.Add(nuevo);
        _valorTotalCache += nuevo.ValorTotal;
        _cambiosPendientes = true;
    }

    public bool Eliminar(int indice)
    {
        if (!IndiceValido(indice)) return false;

        _valorTotalCache -= _productos[indice].ValorTotal;
        _productos.RemoveAt(indice);
        _cambiosPendientes = true;
        return true;
    }

    public bool ModificarCantidad(int indice, int cantidad)
    {
        if (!IndiceValido(indice)) return false;

        var p = _productos[indice];
        _valorTotalCache -= p.ValorTotal;
        p.Cantidad = cantidad;
        _valorTotalCache += p.ValorTotal;

        _cambiosPendientes = true;
        return true;
    }

    public bool ModificarPrecio(int indice, decimal precio)
    {
        if (!IndiceValido(indice)) return false;

        var p = _productos[indice];
        _valorTotalCache -= p.ValorTotal;
        p.Precio = precio;
        _valorTotalCache += p.ValorTotal;

        _cambiosPendientes = true;
        return true;
    }

    public bool ModificarNombre(int indice, string nuevoNombre)
    {
        if (!IndiceValido(indice)) return false;

        _productos[indice].Nombre = nuevoNombre;
        _cambiosPendientes = true;
        return true;
    }

    public Producto BuscarPorNombre(string nombre)
    {
        for (int i = 0; i < _productos.Count; i++)
        {
            var p = _productos[i];
            if (p.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase))
                return p;
        }
        return null;
    }

    public List<Producto> Buscar(string texto)
    {
        var lista = new List<Producto>();
        if (string.IsNullOrEmpty(texto)) return lista;

        for (int i = 0; i < _productos.Count; i++)
        {
            var p = _productos[i];
            if (p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
                lista.Add(p);
        }

        return lista;
    }

    public decimal ValorTotalInventario() => _valorTotalCache;

    public bool EstaVacio() => _productos.Count == 0;

    public bool IndiceValido(int i) => i >= 0 && i < _productos.Count;

    public string ExportarCSV()
    {
        string ruta = Path.Combine(Directory.GetCurrentDirectory(), "inventario.csv");

        using var fs = new FileStream(ruta, FileMode.Create, FileAccess.Write, FileShare.None);
        using var sw = new StreamWriter(fs, Encoding.UTF8);

        sw.WriteLine("Nombre;Cantidad;Precio (€);Total (€)");

        for (int i = 0; i < _productos.Count; i++)
        {
            var p = _productos[i];

            string nombreSeguro = (p.Nombre.Contains(';') || p.Nombre.Contains(','))
                ? $"\"{p.Nombre}\""
                : p.Nombre;

            sw.WriteLine($"{nombreSeguro};{p.Cantidad};{p.Precio:F2};{p.ValorTotal:F2}");
        }

        return ruta;
    }

    public string ImportarCSV(string archivo)
    {
        if (!File.Exists(archivo))
            return "El archivo no existe.";

        int importados = 0;

        using var fs = new FileStream(archivo, FileMode.Open, FileAccess.Read, FileShare.Read);
        using var sr = new StreamReader(fs, Encoding.UTF8);

        string? linea;
        bool primera = true;

        while ((linea = sr.ReadLine()) != null)
        {
            if (primera) { primera = false; continue; }
            if (linea.Length == 0) continue;

            var partes = linea.Split(';');
            if (partes.Length < 4) continue;

            string nombre = partes[0].Trim().Trim('"');
            if (!int.TryParse(partes[1], out int cantidad)) continue;
            if (!decimal.TryParse(partes[2], out decimal precio)) continue;

            Añadir(new Producto
            {
                Nombre = nombre,
                Cantidad = cantidad,
                Precio = precio
            });

            importados++;
        }

        return $"Importación completada. Productos importados: {importados}";
    }

    public void GuardarSiHaceFalta()
    {
        if (!_cambiosPendientes) return;

        var opciones = new JsonSerializerOptions { WriteIndented = false };

        using var fs = new FileStream(ArchivoJSON, FileMode.Create, FileAccess.Write, FileShare.None);
        JsonSerializer.Serialize(fs, _productos, opciones);

        if (OperatingSystem.IsWindows())
            File.SetAttributes(ArchivoJSON, FileAttributes.Hidden);

        _cambiosPendientes = false;
    }

    private List<Producto> Cargar()
    {
        if (!File.Exists(ArchivoJSON)) return new List<Producto>();

        try
        {
            using var fs = new FileStream(ArchivoJSON, FileMode.Open, FileAccess.Read, FileShare.Read);
            return JsonSerializer.Deserialize<List<Producto>>(fs) ?? new List<Producto>();
        }
        catch
        {
            return new List<Producto>();
        }
    }

    private void RecalcularValorTotal()
    {
        decimal total = 0;
        for (int i = 0; i < _productos.Count; i++)
            total += _productos[i].ValorTotal;
        _valorTotalCache = total;
    }
}

static class UI
{
    public static void LimpiarPantalla()
    {
        Console.Clear();
        Console.CursorVisible = true;
    }

    public static void MostrarTitulo(string titulo)
    {
        LimpiarPantalla();
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("╔" + new string('═', 136) + "╗");
        Console.WriteLine("║" + CentrarTexto("🏪  SISTEMA DE GESTIÓN DE INVENTARIO  🏪", 136) + "║");
        Console.WriteLine("╚" + new string('═', 136) + "╝");
        Console.ResetColor();
        
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.WriteLine("\n" + CentrarTexto(titulo, 136));
        Console.WriteLine(CentrarTexto(new string('═', titulo.Length), 136));
        Console.ResetColor();
        Console.WriteLine();
    }

    public static string CentrarTexto(string texto, int ancho)
    {
        int espacios = (ancho - texto.Length) / 2;
        return new string(' ', Math.Max(0, espacios)) + texto;
    }

    public static void MensajeOk(string msg)
    {
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine($"\n  ✓ {msg}\n");
        Console.ResetColor();
    }

    public static void MensajeAviso(string msg)
    {
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.WriteLine($"\n  ⚠ {msg}\n");
        Console.ResetColor();
    }

    public static void MensajeError(string msg)
    {
        Console.ForegroundColor = ConsoleColor.Red;
        Console.WriteLine($"\n  ✗ {msg}\n");
        Console.ResetColor();
    }

    public static string LeerTexto(string etiqueta)
    {
        while (true)
        {
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.Write($"\n  ▶ {etiqueta}: ");
            Console.ResetColor();
            string valor = Console.ReadLine()?.Trim() ?? "";
            if (valor.Length > 0) return valor;
            MensajeError("El texto no puede estar vacío.");
        }
    }

    public static int LeerEnteroPositivo(string etiqueta)
    {
        while (true)
        {
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.Write($"\n  ▶ {etiqueta}: ");
            Console.ResetColor();
            if (int.TryParse(Console.ReadLine(), out int v) && v >= 0)
                return v;
            MensajeError("Introduce un número entero ≥ 0.");
        }
    }

    public static decimal LeerDecimalPositivo(string etiqueta)
    {
        while (true)
        {
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.Write($"\n  ▶ {etiqueta}: ");
            Console.ResetColor();
            if (decimal.TryParse(Console.ReadLine(), out decimal v) && v >= 0)
                return v;
            MensajeError("Introduce un número decimal ≥ 0.");
        }
    }

    public static int LeerOpcion(string etiqueta, int min, int max)
    {
        while (true)
        {
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.Write($"\n  ▶ {etiqueta}: ");
            Console.ResetColor();
            if (int.TryParse(Console.ReadLine(), out int v) && v >= min && v <= max)
                return v;
            MensajeError($"Opción no válida. Introduce un número entre {min} y {max}.");
        }
    }

    public static int SeleccionarProducto(IReadOnlyList<Producto> lista, string accion)
    {
        Console.WriteLine($"\n  📋 Selecciona el producto a {accion}:\n");
        Console.ForegroundColor = ConsoleColor.DarkCyan;
        Console.WriteLine("  " + new string('─', 134));
        
        for (int i = 0; i < lista.Count; i++)
        {
            var p = lista[i];
            Console.ResetColor();
            Console.WriteLine($"    {i + 1,3}. {p.Nombre,-35} │ Cantidad: {p.Cantidad,5} │ Precio: {p.Precio,10:F2}€ │ Total: {p.ValorTotal,12:F2}€");
        }
        
        Console.ForegroundColor = ConsoleColor.DarkCyan;
        Console.WriteLine("  " + new string('─', 134));
        Console.ResetColor();
        Console.WriteLine("      0. Volver");

        int op = LeerOpcion("Número", 0, lista.Count);
        return op == 0 ? -1 : op - 1;
    }

    public static void Pausa()
    {
        Console.ForegroundColor = ConsoleColor.DarkGray;
        Console.WriteLine("\n  ⏸  Pulsa ENTER para continuar...");
        Console.ResetColor();
        Console.ReadLine();
    }
}

class MenuInventario
{
    private readonly RepositorioProductos _repo;

    public MenuInventario(RepositorioProductos repo)
    {
        _repo = repo;
    }

    public void Ejecutar()
    {
        bool salir = false;

        while (!salir)
        {
            UI.MostrarTitulo("MENÚ PRINCIPAL");

            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine("  " + new string('═', 134));
            Console.WriteLine("  │ GESTIÓN DE PRODUCTOS");
            Console.WriteLine("  " + new string('═', 134));
            Console.ResetColor();
            Console.WriteLine("    1. ➕ Añadir producto");
            Console.WriteLine("    2. ➖ Eliminar producto");
            Console.WriteLine("    3. ✏️  Modificar producto");

            Console.ForegroundColor = ConsoleColor.Green;
            Console.WriteLine("\n  " + new string('═', 134));
            Console.WriteLine("  │ CONSULTAS");
            Console.WriteLine("  " + new string('═', 134));
            Console.ResetColor();
            Console.WriteLine("    4. 📊 Mostrar inventario completo");
            Console.WriteLine("    5. 🔍 Buscar producto");

            Console.ForegroundColor = ConsoleColor.Magenta;
            Console.WriteLine("\n  " + new string('═', 134));
            Console.WriteLine("  │ IMPORTAR / EXPORTAR");
            Console.WriteLine("  " + new string('═', 134));
            Console.ResetColor();
            Console.WriteLine("    6. 📤 Exportar inventario a CSV");
            Console.WriteLine("    7. 📥 Importar inventario desde CSV");

            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine("\n  " + new string('═', 134));
            Console.WriteLine("  │ SISTEMA");
            Console.WriteLine("  " + new string('═', 134));
            Console.ResetColor();
            Console.WriteLine("    8. 🚪 Salir");

            int op = UI.LeerOpcion("Selecciona una opción", 1, 8);

            switch (op)
            {
                case 1: AñadirProducto(); break;
                case 2: EliminarProducto(); break;
                case 3: ModificarProducto(); break;
                case 4: MostrarInventario(); break;
                case 5: BuscarProducto(); break;
                case 6: ExportarCSV(); break;
                case 7: ImportarCSV(); break;
                case 8: salir = Salir(); break;
            }
        }
    }

    private void AñadirProducto()
    {
        UI.MostrarTitulo("➕ AÑADIR NUEVO PRODUCTO");

        Console.WriteLine("  (Escribe '0' en el nombre para volver)\n");
        string nombre = UI.LeerTexto("Nombre del producto");
        if (nombre == "0") return;

        int cantidad = UI.LeerEnteroPositivo("Cantidad (unidades)");
        decimal precio = UI.LeerDecimalPositivo("Precio (€)");

        bool yaExistia = _repo.BuscarPorNombre(nombre) != null;

        _repo.Añadir(new Producto
        {
            Nombre = nombre,
            Cantidad = cantidad,
            Precio = precio
        });

        UI.MensajeOk(yaExistia
            ? $"Stock de '{nombre}' actualizado correctamente."
            : $"Producto '{nombre}' añadido correctamente.");

        UI.Pausa();
    }

    private void EliminarProducto()
    {
        UI.MostrarTitulo("➖ ELIMINAR PRODUCTO");

        if (_repo.EstaVacio())
        {
            UI.MensajeAviso("El inventario está vacío.");
            UI.Pausa();
            return;
        }

        int idx = UI.SeleccionarProducto(_repo.Productos, "eliminar");
        if (idx == -1) return;

        string nombre = _repo.Productos[idx].Nombre;

        Console.ForegroundColor = ConsoleColor.Red;
        Console.Write($"\n  ⚠️  ¿Seguro que quieres eliminar '{nombre}'? (s/N): ");
        Console.ResetColor();
        if (!string.Equals(Console.ReadLine()?.Trim(), "s", StringComparison.OrdinalIgnoreCase))
            return;

        _repo.Eliminar(idx);
        UI.MensajeOk($"Producto '{nombre}' eliminado correctamente.");
        UI.Pausa();
    }

    private void ModificarProducto()
    {
        UI.MostrarTitulo("✏️  MODIFICAR PRODUCTO");

        if (_repo.EstaVacio())
        {
            UI.MensajeAviso("El inventario está vacío.");
            UI.Pausa();
            return;
        }

        int idx = UI.SeleccionarProducto(_repo.Productos, "modificar");
        if (idx == -1) return;

        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("\n  " + new string('═', 134));
        Console.ResetColor();
        Console.WriteLine("    1. Modificar cantidad");
        Console.WriteLine("    2. Modificar precio");
        Console.WriteLine("    3. Modificar nombre");
        Console.WriteLine("    0. Volver");

        int op = UI.LeerOpcion("Selecciona qué modificar", 0, 3);
        if (op == 0) return;

        if (op == 1)
        {
            int nuevaCantidad = UI.LeerEnteroPositivo("Nueva cantidad");
            _repo.ModificarCantidad(idx, nuevaCantidad);
        }
        else if (op == 2)
        {
            decimal nuevoPrecio = UI.LeerDecimalPositivo("Nuevo precio (€)");
            _repo.ModificarPrecio(idx, nuevoPrecio);
        }
        else if (op == 3)
        {
            string nuevoNombre = UI.LeerTexto("Nuevo nombre");
            _repo.ModificarNombre(idx, nuevoNombre);
        }

        UI.MensajeOk("Producto modificado correctamente.");
        UI.Pausa();
    }

    private void MostrarInventario()
    {
        UI.MostrarTitulo("📊 INVENTARIO COMPLETO");

        if (_repo.EstaVacio())
        {
            UI.MensajeAviso("El inventario está vacío.");
            UI.Pausa();
            return;
        }

        ImprimirTabla(_repo.Productos);

        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine($"\n  💰 Valor total del inventario: ");
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.WriteLine($"      {_repo.ValorTotalInventario():F2}€\n");
        Console.ResetColor();

        UI.Pausa();
    }

    private void BuscarProducto()
    {
        UI.MostrarTitulo("🔍 BUSCAR PRODUCTO");

        string texto = UI.LeerTexto("Texto a buscar");
        var resultados = _repo.Buscar(texto);

        if (resultados.Count == 0)
        {
            UI.MensajeAviso($"No se encontraron productos que coincidan con '{texto}'.");
        }
        else
        {
            Console.WriteLine($"\n  ✓ Se encontraron {resultados.Count} resultado(s):\n");
            ImprimirTabla(resultados);
        }

        UI.Pausa();
    }

    private void ExportarCSV()
    {
        UI.MostrarTitulo("📤 EXPORTAR INVENTARIO A CSV");

        if (_repo.EstaVacio())
        {
            UI.MensajeAviso("El inventario está vacío.");
            UI.Pausa();
            return;
        }

        string ruta = _repo.ExportarCSV();

        UI.MensajeOk("Inventario exportado correctamente.");
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("  📁 Archivo generado en:");
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.WriteLine($"     {ruta}\n");
        Console.ResetColor();

        UI.Pausa();
    }

    private void ImportarCSV()
    {
        UI.MostrarTitulo("📥 IMPORTAR INVENTARIO DESDE CSV");

        string archivo = UI.LeerTexto("Ruta del archivo CSV");
        string resultado = _repo.ImportarCSV(archivo);

        if (resultado.StartsWith("Importación", StringComparison.Ordinal))
            UI.MensajeOk(resultado);
        else
            UI.MensajeError(resultado);

        UI.Pausa();
    }

    private bool Salir()
    {
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.Write($"\n  ⚠️  ¿Seguro que quieres salir? (s/N): ");
        Console.ResetColor();
        if (!string.Equals(Console.ReadLine()?.Trim(), "s", StringComparison.OrdinalIgnoreCase))
            return false;

        Console.Clear();
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine();
        Console.WriteLine("╔" + new string('═', 136) + "╗");
        Console.WriteLine("║" + UI.CentrarTexto("👋 ¡Hasta pronto! Los datos han sido guardados.", 136) + "║");
        Console.WriteLine("╚" + new string('═', 136) + "╝");
        Console.ResetColor();
        Console.WriteLine();
        return true;
    }

    private static void ImprimirTabla(IReadOnlyList<Producto> lista)
    {
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("  " + new string('═', 134));
        Console.WriteLine("  │ {0,-35} │ {1,10} │ {2,12} │ {3,15} │", "NOMBRE", "CANTIDAD", "PRECIO (€)", "TOTAL (€)");
        Console.WriteLine("  " + new string('═', 134));
        Console.ResetColor();

        for (int i = 0; i < lista.Count; i++)
        {
            var p = lista[i];
            string nombre = p.Nombre.Length > 35 ? p.Nombre.Substring(0, 32) + "..." : p.Nombre;
            Console.WriteLine("  │ {0,-35} │ {1,10} │ {2,12:F2}€ │ {3,15:F2}€ │", nombre, p.Cantidad, p.Precio, p.ValorTotal);
        }

        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("  " + new string('═', 134));
        Console.ResetColor();
    }
}

class Program
{
    static void Main()
    {
        Console.OutputEncoding = Encoding.UTF8;
        Console.Title = "🏪 Sistema de Gestión de Inventario";
        
        // Maximizar ventana
        try
        {
            Console.WindowWidth = 140;
            Console.WindowHeight = 40;
            Console.BufferWidth = 140;
            Console.BufferHeight = 500;
        }
        catch { }

        var repo = new RepositorioProductos();
        var menu = new MenuInventario(repo);
        menu.Ejecutar();

        repo.GuardarSiHaceFalta();
    }
}
